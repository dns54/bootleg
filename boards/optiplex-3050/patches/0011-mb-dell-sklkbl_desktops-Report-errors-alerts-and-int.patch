diff --git a/src/mainboard/dell/sklkbl_desktops/diag.c b/src/mainboard/dell/sklkbl_desktops/diag.c
new file mode 100644
index 0000000000..6afb8a668d
--- /dev/null
+++ b/src/mainboard/dell/sklkbl_desktops/diag.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#define __SIMPLE_DEVICE__
+
+#include <arch/io.h>
+#include <console/console.h>
+#include <delay.h>
+#include <device/azalia_device.h>
+#include <device/pci_ops.h>
+#include <device/pnp_ops.h>
+#include <pc80/i8254.h>
+#include <soc/iomap.h>
+#include <soc/pci_devs.h>
+#include <superio/smsc/sch555x/sch555x.h>
+#include "diag.h"
+
+/* SCH5555 LED register: bits 1:0 off/blink/on, bit 2 white instead of amber */
+#define LED_AMBER_ON	0x03
+#define LED_OFF		0x00
+
+static unsigned int code_first, code_second;
+
+void diag_set(unsigned int first, unsigned int second)
+{
+	code_first = first;
+	code_second = second;
+}
+
+static void blink(unsigned int count)
+{
+	for (unsigned int i = 0; i < count; i++) {
+		outb(LED_AMBER_ON, SCH555x_RUNTIME_IOBASE + SCH555x_RUNTIME_LED);
+		mdelay(300);
+		outb(LED_OFF, SCH555x_RUNTIME_IOBASE + SCH555x_RUNTIME_LED);
+		mdelay(300);
+	}
+}
+
+/* Dell's memory failure code 1-3-2, at the pitch of Dasharo's failure beeps */
+static void memory_beeps(void)
+{
+	static const unsigned int groups[] = { 1, 3, 2 };
+
+	for (size_t i = 0; i < ARRAY_SIZE(groups); i++) {
+		for (unsigned int j = 0; j < groups[i]; j++) {
+			beep(800, 300);
+			mdelay(150);
+		}
+		mdelay(500);
+	}
+}
+
+/* PC beep (mixer 0x0b input 4) through mixers 0x0c/0x0d to speaker pin 0x14, muted after reset */
+void diag_open_beep_path(u8 *base)
+{
+	static const u32 verbs[] = {
+		0x00b37417,	/* 0x0b: input 4 (PC beep) unmuted, 0 dB */
+		0x00c37100,	/* 0x0c: input 1 (0x0b) unmuted */
+		0x00d37100,	/* 0x0d: input 1 (0x0b) unmuted */
+		0x0143b000,	/* 0x14: output amp unmuted */
+		0x01470740,	/* 0x14: pin output enabled */
+		0x01470c02,	/* 0x14: EAPD on */
+	};
+
+	azalia_program_verb_table(base, verbs, ARRAY_SIZE(verbs));
+}
+
+/* Memory errors beep in romstage, before ramstage opens the beep path. The BAR is free this early. */
+static void romstage_open_beep_path(void)
+{
+	const pci_devfn_t dev = PCH_DEV_HDA;
+	u8 *const base = (u8 *)EARLY_I2C_BASE_ADDRESS;
+
+	if (pci_read_config16(dev, PCI_VENDOR_ID) == 0xffff)
+		return;
+	pci_write_config32(dev, PCI_BASE_ADDRESS_0, (uintptr_t)base);
+	pci_write_config32(dev, PCI_BASE_ADDRESS_1, 0);
+	pci_or_config16(dev, PCI_COMMAND, PCI_COMMAND_MEMORY);
+	if (azalia_exit_reset(base) != CB_SUCCESS)
+		return;
+	/* The codec asks for an address within 521 us, then needs time to come out of reset */
+	mdelay(10);
+	diag_open_beep_path(base);
+}
+
+void die_notify(void)
+{
+	bool memory;
+
+	if (!code_first) {
+		if (ENV_SEPARATE_ROMSTAGE)
+			diag_set(DIAG_MEMORY_FAILURE);
+		else
+			diag_set(DIAG_BOARD_FAILURE);
+	}
+	memory = (code_first == 3 && code_second == 3) || (code_first == 2 && code_second == 7);
+
+	printk(BIOS_EMERG, "Diagnostic code %u,%u\n", code_first, code_second);
+	/* As on Dell, no option silences the memory code */
+	if (memory) {
+		if (ENV_SEPARATE_ROMSTAGE)
+			romstage_open_beep_path();
+		memory_beeps();
+	}
+
+	for (;;) {
+		blink(code_first);
+		mdelay(1000);
+		blink(code_second);
+		mdelay(3000);
+	}
+}
diff --git a/src/mainboard/dell/sklkbl_desktops/diag.h b/src/mainboard/dell/sklkbl_desktops/diag.h
new file mode 100644
index 0000000000..c471d7c4f7
--- /dev/null
+++ b/src/mainboard/dell/sklkbl_desktops/diag.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef MAINBOARD_DIAG_H
+#define MAINBOARD_DIAG_H
+
+/* Dell's diagnostic codes: two groups of amber power LED blinks */
+#define DIAG_NO_MEMORY		3, 3
+#define DIAG_MEMORY_FAILURE	2, 7
+#define DIAG_BOARD_FAILURE	3, 6
+
+#include <types.h>
+
+void diag_set(unsigned int first, unsigned int second);
+void diag_open_beep_path(u8 *base);
+
+enum beep_codes {
+	BEEP_CODES_DISABLED,
+	BEEP_CODES_ERRORS,
+	BEEP_CODES_ERRORS_AND_POST,
+};
+
+/* Same bits in edk2's BootAlerts.c */
+#define BOOT_ALERT_INTRUSION	(1 << 0)
+#define BOOT_ALERT_RTC_BATTERY	(1 << 1)
+#define BOOT_ALERT_THERMTRIP	(1 << 2)
+#define BOOT_ALERT_FAN		(1 << 3)
+
+unsigned int boot_alerts(void);
+
+#endif
