diff --git a/src/mainboard/dell/sklkbl_desktops/ramstage.c b/src/mainboard/dell/sklkbl_desktops/ramstage.c
index 3f400f82b5..394963d8ba 100644
--- a/src/mainboard/dell/sklkbl_desktops/ramstage.c
+++ b/src/mainboard/dell/sklkbl_desktops/ramstage.c
@@ -10,8 +10,13 @@
 #include <cpu/x86/msr.h>
 #include <halt.h>
 #include <intelblocks/pmclib.h>
+#include <intelblocks/tco.h>
 #include <option.h>
+#include <security/tpm/tspi.h>
 #include <soc/gpio.h>
+#include <soc/intel/common/tco.h>
+#include <device/pnp_ops.h>
+#include <superio/smsc/sch555x/sch555x.h>
 #include <soc/pci_devs.h>
 #include <soc/pm.h>
 #include <soc/pmc.h>
@@ -19,7 +24,8 @@
 #include <soc/soc_chip.h>
 #include <static.h>
 #include "../../../include/variant/gpio.h"
-#include <superio/smsc/sch555x/sch555x.h>
+#include "diag.h"
+#include "intrusion.h"
 
 void mainboard_silicon_init_params(FSP_SIL_UPD *params)
 {
@@ -608,6 +614,66 @@ void mainboard_azalia_program_runtime_verbs(u8 *base, u32 viddid)
 		AZALIA_PIN_CFG(0, 0x14, AZALIA_PIN_CFG_NC(0)),
 	};
 
-	if (viddid == 0x10ec0255 && !get_uint_option("speaker", 1))
+	if (viddid != 0x10ec0255)
+		return;
+	if (!get_uint_option("speaker", 1))
 		azalia_program_verb_table(base, speaker_off, ARRAY_SIZE(speaker_off));
+	else if (get_uint_option("beep_codes", BEEP_CODES_ERRORS) != BEEP_CODES_DISABLED)
+		diag_open_beep_path(base);
+}
+
+/*
+ * INTRUDER# latches INTRD_DET in the RTC well, so an opening is recorded with the system off.
+ * coreboot leaves it set while it isn't routed to SMI. Measure it into PCR 1, so secrets sealed
+ * to PCR 1 don't unseal. Pulling the coin cell clears the latch with the rest of the RTC well,
+ * so measure a loss of RTC power too.
+ */
+static bool intrusion_alert;
+
+static void measure_tamper(const char *event, size_t size)
+{
+	struct tpm_digests digests;
+
+	printk(BIOS_WARNING, "Tamper event: %s\n", event);
+	if (CONFIG(TPM_MEASURED_BOOT) && tpm_make_digests(event, size, NULL, &digests))
+		tpm_extend_pcr(1, digests.values, event);
+}
+
+static void chassis_intrusion(void *arg)
+{
+	const char event[] = "Chassis intrusion";
+	const char rtc_event[] = "RTC power lost";
+	const unsigned int mode = get_uint_option("chassis_intrusion", INTRUSION_ENABLED);
+	const struct chipset_power_state *ps = pmc_get_power_state();
+	bool intrusion;
+
+	if (get_uint_option("clear_intrusion", 0)) {
+		tco_write_reg(TCO2_STS, TCO2_INTRD_DET);
+		set_uint_option("clear_intrusion", 0);
+		printk(BIOS_INFO, "Chassis intrusion cleared\n");
+	}
+
+	intrusion = mode != INTRUSION_DISABLED && (tco_read_reg(TCO2_STS) & TCO2_INTRD_DET);
+	intrusion_alert = intrusion && mode == INTRUSION_ENABLED;
+	if (mode != INTRUSION_DISABLED && ps && (ps->gen_pmcon_b & RTC_BATTERY_DEAD))
+		measure_tamper(rtc_event, sizeof(rtc_event));
+	if (intrusion)
+		measure_tamper(event, sizeof(event));
+}
+
+/* Before the SPI lockdown on BS_DEV_RESOURCES exit, which blocks option writes outside SMM */
+BOOT_STATE_INIT_ENTRY(BS_DEV_INIT_CHIPS, BS_ON_EXIT, chassis_intrusion, NULL);
+
+unsigned int boot_alerts(void)
+{
+	const struct chipset_power_state *ps = pmc_get_power_state();
+	unsigned int alerts = intrusion_alert ? BOOT_ALERT_INTRUSION : 0;
+
+	if (ps && (ps->gen_pmcon_b & RTC_BATTERY_DEAD))
+		alerts |= BOOT_ALERT_RTC_BATTERY;
+	if (ps && (ps->gblrst_cause[0] & GBLRST_CAUSE0_THERMTRIP))
+		alerts |= BOOT_ALERT_THERMTRIP;
+	if (sch555x_fan_failure())
+		alerts |= BOOT_ALERT_FAN;
+	return alerts;
 }
