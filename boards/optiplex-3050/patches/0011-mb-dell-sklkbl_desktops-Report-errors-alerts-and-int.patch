+++ b/src/mainboard/dell/sklkbl_desktops/variants/optiplex_3050/romstage.c
@@ -1,12 +1,18 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 
 #include <soc/romstage.h>
+#include <console/console.h>
 #include <spd_bin.h>
+#include "../../diag.h"
 
 void mainboard_memory_init_params(FSPM_UPD *mupd)
 {
 	struct spd_block blk = { .addr_map = { 0x50, 0x52, } };
 	get_spd_smbus(&blk);
+	if (!blk.spd_array[0] && !blk.spd_array[1]) {
+		diag_set(DIAG_NO_MEMORY);
+		die("No memory modules found\n");
+	}
 	dump_spd_info(&blk);
 
 	FSP_M_CONFIG *mem_cfg = &mupd->FspmConfig;
