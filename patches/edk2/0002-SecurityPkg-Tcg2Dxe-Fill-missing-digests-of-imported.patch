   TCG_PCR_EVENT_HDR                SpecIdEvent;
@@ -1874,11 +1919,11 @@ SetupEventLog (
       while (!EFI_ERROR (Status) &&
              (GuidHob.Raw = GetNextGuidHob (mTcg2EventInfo[Index].EventGuid, GuidHob.Raw)) != NULL)
