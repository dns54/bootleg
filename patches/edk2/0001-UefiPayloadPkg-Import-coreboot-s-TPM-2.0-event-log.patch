diff --git a/UefiPayloadPkg/UefiPayloadEntry/UefiPayloadEntry.c b/UefiPayloadPkg/UefiPayloadEntry/UefiPayloadEntry.c
index 55c23671c9..4cdab037c1 100644
--- a/UefiPayloadPkg/UefiPayloadEntry/UefiPayloadEntry.c
+++ b/UefiPayloadPkg/UefiPayloadEntry/UefiPayloadEntry.c
@@ -334,6 +334,80 @@ MemInfoCallback (
   return RETURN_SUCCESS;
 }
 
+// PCRIndex, EventType and the digest count come before the digests.
+#define TCG_PCR_EVENT2_DIGESTS_OFFSET  (sizeof (UINT32) * 3)
+
+/**
+  Turn the bootloader's TPM 2.0 event log into event HOBs, which Tcg2Dxe copies
+  into the EFI event log as it would events from a PEI phase.
+
+  Every event carries one digest per algorithm of the log's Spec ID Event.
+
+  @param  Log     The event log.
+  @param  Size    Size of the event log area.
+**/
+STATIC
+VOID
+ImportTpm2EventLog (
+  IN CONST VOID  *Log,
+  IN UINTN       Size
+  )
+{
+  CONST TCG_PCR_EVENT_HDR                *SpecIdHeader;
+  CONST TCG_EfiSpecIDEventStruct         *SpecId;
+  CONST TCG_EfiSpecIdEventAlgorithmSize  *AlgorithmSizes;
+  CONST UINT8                            *Entry;
+  UINT32                                 NumberOfAlgorithms;
+  UINTN                                  DigestsSize;
+  UINTN                                  EntrySize;
+  UINTN                                  Offset;
+  UINTN                                  Index;
+
+  SpecIdHeader = Log;
+  SpecId       = (CONST TCG_EfiSpecIDEventStruct *)(SpecIdHeader + 1);
+  if ((Size < sizeof (*SpecIdHeader) + sizeof (*SpecId) + sizeof (UINT32)) ||
+      (SpecIdHeader->EventType != EV_NO_ACTION) ||
+      (SpecIdHeader->EventSize > Size - sizeof (*SpecIdHeader)) ||
+      (CompareMem (SpecId->signature, TCG_EfiSpecIDEventStruct_SIGNATURE_03, sizeof (SpecId->signature)) != 0) ||
+      (SpecId->specVersionMajor != 2) || (SpecId->specVersionMinor != 0))
+  {
+    DEBUG ((DEBUG_WARN, "%a: unknown TPM 2.0 log format, not importing it\n", __func__));
+    return;
+  }
+
+  NumberOfAlgorithms = ReadUnaligned32 ((CONST UINT32 *)(SpecId + 1));
+  AlgorithmSizes     = (CONST TCG_EfiSpecIdEventAlgorithmSize *)((CONST UINT8 *)(SpecId + 1) + sizeof (UINT32));
+  if (sizeof (*SpecId) + sizeof (UINT32) + (UINT64)NumberOfAlgorithms * sizeof (*AlgorithmSizes) > SpecIdHeader->EventSize) {
+    DEBUG ((DEBUG_WARN, "%a: malformed Spec ID Event, not importing the log\n", __func__));
+    return;
+  }
+
+  DigestsSize = 0;
+  for (Index = 0; Index < NumberOfAlgorithms; Index++) {
+    DigestsSize += sizeof (TPMI_ALG_HASH) + AlgorithmSizes[Index].digestSize;
+  }
+
+  // Tcg2Dxe writes its own Spec ID Event, listing the active PCR banks.
+  Offset = sizeof (*SpecIdHeader) + SpecIdHeader->EventSize;
+  while (Offset + TCG_PCR_EVENT2_DIGESTS_OFFSET + DigestsSize + sizeof (UINT32) <= Size) {
+    Entry = (CONST UINT8 *)Log + Offset;
+    // Unused space after the last event is zeroed.
+    if (IsZeroBuffer (Entry, TCG_PCR_EVENT2_DIGESTS_OFFSET)) {
+      break;
+    }
+
+    EntrySize = TCG_PCR_EVENT2_DIGESTS_OFFSET + DigestsSize + sizeof (UINT32) +
+                ReadUnaligned32 ((CONST UINT32 *)(Entry + TCG_PCR_EVENT2_DIGESTS_OFFSET + DigestsSize));
+    if (EntrySize > Size - Offset) {
+      DEBUG ((DEBUG_WARN, "%a: truncated event at offset 0x%x\n", __func__, Offset));
+      break;
+    }
+
+    BuildGuidDataHob (&gTcgEvent2EntryHobGuid, (VOID *)Entry, EntrySize);
+    Offset += EntrySize;
+  }
+}
+
 /**
   It will build HOBs based on information from bootloaders.
 
@@ -355,6 +429,8 @@ BuildHobFromBl (
   TCG_PHYSICAL_PRESENCE_INFO        *NewPhysicalPresenceInfo;
   BOOT_MEDIA_INFO                   BootMediaInfo;
   BOOT_MEDIA_INFO                   *NewBootMediaInfo;
+  VOID                              *Tpm2EventLog;
+  UINT32                            Tpm2EventLogSize;
   EFI_PEI_GRAPHICS_INFO_HOB         GfxInfo;
   EFI_PEI_GRAPHICS_INFO_HOB         *NewGfxInfo;
   EFI_PEI_GRAPHICS_DEVICE_INFO_HOB  GfxDeviceInfo;
@@ -446,6 +522,11 @@ BuildHobFromBl (
     DEBUG ((DEBUG_INFO, "Created boot media info hob\n"));
   }
 
+  Status = ParseTpm2EventLog (&Tpm2EventLog, &Tpm2EventLogSize);
+  if (!EFI_ERROR (Status)) {
+    ImportTpm2EventLog (Tpm2EventLog, Tpm2EventLogSize);
+  }
+
   //
   // Create SmBios table Hob
   //
