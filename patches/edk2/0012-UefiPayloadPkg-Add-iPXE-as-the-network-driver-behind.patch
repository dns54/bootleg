+++ b/UefiPayloadPkg/Include/Library/CfrHelpersLib.h
@@ -50,4 +50,20 @@ CfrOptionGetDefaultValue (
   IN OUT UINTN  *DefaultValueLength  OPTIONAL
   );
 
+/**
+  Return the value of a numeric or boolean option: its variable if one is set, otherwise its CFR
+  default, otherwise Default. Reads the variable through gRT, so DXE and later only.
+
+  @param[in]  OptionName  The option's name, which is also the name of its variable.
+  @param[in]  Default     The value when there is neither a variable nor a CFR default.
+
+  @return The option's value.
+**/
+UINT32
+EFIAPI
+CfrOptionGetUint32 (
+  IN CHAR8   *OptionName,
+  IN UINT32  Default
+  );
