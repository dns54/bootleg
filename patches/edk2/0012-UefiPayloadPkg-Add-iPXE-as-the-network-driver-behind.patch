diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
index 7a9d7f0794..e125480f9b 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
@@ -413,6 +413,83 @@ PlatformRegisterBootManagerEntryNotifyCallback (
   }
 }
 
+/**
+  Adjust the boot options the boot manager enumerates. Network boot options exist only while the
+  "Enable UEFI Network Stack" setup option is on.
+
+  @param[in]  BootOptions              The enumerated boot options.
+  @param[in]  BootOptionsCount         Number of enumerated boot options.
+  @param[out] UpdatedBootOptions       The adjusted boot options.
+  @param[out] UpdatedBootOptionsCount  Number of adjusted boot options.
+
+  @retval EFI_SUCCESS           The boot options were adjusted.
+  @retval EFI_OUT_OF_RESOURCES  Not enough memory.
+**/
+STATIC
+EFI_STATUS
+EFIAPI
+PlatformRefreshAllBootOptions (
+  IN  CONST EFI_BOOT_MANAGER_LOAD_OPTION  *BootOptions,
+  IN  CONST UINTN                         BootOptionsCount,
+  OUT       EFI_BOOT_MANAGER_LOAD_OPTION  **UpdatedBootOptions,
+  OUT       UINTN                         *UpdatedBootOptionsCount
+  )
+{
+  EFI_BOOT_MANAGER_LOAD_OPTION  *Options;
+  EFI_DEVICE_PATH_PROTOCOL      *Node;
+  BOOLEAN                       IsNetwork;
+  BOOLEAN                       NetworkBoot;
+  UINTN                         Index;
+  UINTN                         Count;
+  EFI_STATUS                    Status;
+
+  Options = AllocateZeroPool (MAX (BootOptionsCount, 1) * sizeof (*Options));
+  if (Options == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  NetworkBoot = CfrOptionGetUint32 ("network_stack", FALSE) != 0;
+  Count       = 0;
+  for (Index = 0; Index < BootOptionsCount; Index++) {
+    IsNetwork = FALSE;
+    for (Node = BootOptions[Index].FilePath; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+      if ((DevicePathType (Node) == MESSAGING_DEVICE_PATH) && (DevicePathSubType (Node) == MSG_MAC_ADDR_DP)) {
+        IsNetwork = TRUE;
+      }
+    }
+
+    if (IsNetwork && !NetworkBoot) {
+      continue;
+    }
+
+    Status = EfiBootManagerInitializeLoadOption (
+               &Options[Count],
+               LoadOptionNumberUnassigned,
+               BootOptions[Index].OptionType,
+               BootOptions[Index].Attributes,
+               BootOptions[Index].Description,
+               BootOptions[Index].FilePath,
+               BootOptions[Index].OptionalData,
+               BootOptions[Index].OptionalDataSize
+               );
+    if (EFI_ERROR (Status)) {
+      EfiBootManagerFreeLoadOptions (Options, Count);
+      return Status;
+    }
+
+    Count++;
+  }
+
+  *UpdatedBootOptions      = Options;
+  *UpdatedBootOptionsCount = Count;
+  return EFI_SUCCESS;
+}
+
+STATIC EDKII_PLATFORM_BOOT_MANAGER_PROTOCOL  mPlatformBootManager = {
+  EDKII_PLATFORM_BOOT_MANAGER_PROTOCOL_REVISION,
+  PlatformRefreshAllBootOptions
+};
+
 /**
   Do the platform specific action before the console is connected.
 
@@ -433,6 +510,31 @@ PlatformBootManagerBeforeConsole (
   EFI_INPUT_KEY                 Down;
   EFI_BOOT_MANAGER_LOAD_OPTION  BootOption;
   BOOLEAN                       ConsoleInitialized;
+  EFI_HANDLE                    Handle;
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEdkiiPlatformBootManagerProtocolGuid,
+                  &mPlatformBootManager,
+                  NULL
+                  );
+  ASSERT_EFI_ERROR (Status);
+
+  //
+  // The NIC drivers depend on this protocol: with the network stack off they don't load, so no
+  // NIC gets the network stack or its setup pages. With it on, they load at the next dispatch
+  // (EfiBootManagerConnectAll).
+  //
+  if (CfrOptionGetUint32 ("network_stack", FALSE) != 0) {
+    Status = gBS->InstallProtocolInterface (
+                    &Handle,
+                    &gUefiPayloadNetworkStackPolicyGuid,
+                    EFI_NATIVE_INTERFACE,
+                    NULL
+                    );
+    ASSERT_EFI_ERROR (Status);
+  }
 
   //
   // Register ENTER as CONTINUE key
