--- a/UefiPayloadPkg/Library/CfrHelpersLib/CfrHelpersLib.c
+++ b/UefiPayloadPkg/Library/CfrHelpersLib/CfrHelpersLib.c
@@ -8,13 +8,19 @@
 
 #include <Uefi/UefiBaseType.h>
 #include <Uefi/UefiMultiPhase.h>
+#include <Uefi/UefiSpec.h>
 #include <Pi/PiMultiPhase.h>
 #include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
 #include <Library/CfrHelpersLib.h>
 #include <Library/DebugLib.h>
 #include <Library/HobLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
 #include <Guid/CfrSetupMenuGuid.h>
 
+// Longest option name CfrOptionGetUint32() looks up, with its terminator
+#define CFR_OPTION_NAME_MAX  64
+
 /**
   CFR_VARBINARY records are variable-length, so they aren't formal fields.
   Implement this handling by returning the struct at this offset.
@@ -168,3 +174,44 @@ CfrOptionGetDefaultValue (
 
   return EFI_NOT_FOUND;
 }
+
+/**
+  Return the value of a numeric or boolean option: its variable if one is set, otherwise its CFR
+  default, otherwise Default. Reads the variable through gRT, so DXE and later only.
+
+  @param[in]  OptionName  The option's name, which is also the name of its variable.
+  @param[in]  Default     The value when there is neither a variable nor a CFR default.
+
+  @return The option's value.
+**/
+UINT32
+EFIAPI
+CfrOptionGetUint32 (
+  IN CHAR8   *OptionName,
+  IN UINT32  Default
+  )
+{
+  CHAR16  VariableName[CFR_OPTION_NAME_MAX];
+  UINT32  Value;
+  UINTN   Size;
+  VOID    *DefaultValue;
+
+  if (!EFI_ERROR (AsciiStrToUnicodeStrS (OptionName, VariableName, ARRAY_SIZE (VariableName)))) {
+    Value = 0;
+    Size  = sizeof (Value);
+    if (!EFI_ERROR (gRT->GetVariable (VariableName, &gEficorebootNvDataGuid, NULL, &Size, &Value))) {
+      return Value;
+    }
+  }
+
+  Size = 0;
+  if (!EFI_ERROR (CfrOptionGetDefaultValue (NULL, OptionName, &DefaultValue, &Size)) &&
+      (Size >= 1) && (Size <= sizeof (Value)))
+  {
+    Value = 0;
+    CopyMem (&Value, DefaultValue, Size);
+    return Value;
+  }
+
+  return Default;
+}
