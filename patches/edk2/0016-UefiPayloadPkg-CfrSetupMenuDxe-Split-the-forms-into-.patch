-  ASSERT (mSetupMenuPrivate.HiiHandle != NULL);
+  CfrFindForms (&PlatformForms, &FeatureForms);
+  if (PlatformForms) {
+    mSetupMenuPrivate.PlatformHiiHandle = HiiAddPackages (
+                                            &mSetupMenuFormsetGuid,
+                                            mSetupMenuPrivate.DriverHandle,
+                                            SetupMenuVfrBin,
+                                            CfrSetupMenuDxeStrings,
+                                            NULL
+                                            );
+    ASSERT (mSetupMenuPrivate.PlatformHiiHandle != NULL);
+  }
+
+  if (FeatureForms) {
+    mSetupMenuPrivate.FeaturesHiiHandle = HiiAddPackages (
+                                            &mSystemFeaturesFormsetGuid,
+                                            mSetupMenuPrivate.DriverHandle,
+                                            SystemFeaturesVfrBin,
+                                            CfrSetupMenuDxeStrings,
+                                            NULL
+                                            );
+    ASSERT (mSetupMenuPrivate.FeaturesHiiHandle != NULL);
+  }
 
   //
   // Insert runtime components from bootloader's CFR table.
@@ -112,7 +129,13 @@ CfrSetupMenuUnload (
   //
   // Remove our HII data
   //
-  HiiRemovePackages (mSetupMenuPrivate.HiiHandle);
+  if (mSetupMenuPrivate.PlatformHiiHandle != NULL) {
+    HiiRemovePackages (mSetupMenuPrivate.PlatformHiiHandle);
+  }
+
+  if (mSetupMenuPrivate.FeaturesHiiHandle != NULL) {
+    HiiRemovePackages (mSetupMenuPrivate.FeaturesHiiHandle);
+  }
 
   CfrCleanupLockAtBoot ();
 
