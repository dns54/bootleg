+VOID
+EFIAPI
+CfrFindForms (
+  OUT BOOLEAN  *PlatformForms,
+  OUT BOOLEAN  *FeatureForms
+  );
+
 /**
   Register a ReadyToBoot callback that write-locks CFR variables marked
   CFR_OPTFLAG_LOCK_AT_BOOT.
diff --git a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
index 6dc441f5c8..a0dc558c03 100644
--- a/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
+++ b/UefiPayloadPkg/CfrSetupMenuDxe/SetupMenuCfr.c
@@ -1034,7 +1034,39 @@ CfrProcessCharacterOption (
 }
 
 /**
-  Create runtime components by iterating CFR forms.
+  Report which kinds of CFR forms the bootloader provided.
+
+  @param[out] PlatformForms  Forms flagged CFR_OPTFLAG_PLATFORM, for the Platform Setup Menu.
+  @param[out] FeatureForms   Other forms, for System Features.
+
+**/
+VOID
+EFIAPI
+CfrFindForms (
+  OUT BOOLEAN  *PlatformForms,
+  OUT BOOLEAN  *FeatureForms
+  )
+{
+  EFI_HOB_GUID_TYPE  *GuidHob;
+  CFR_OPTION_FORM    *Form;
+
+  *PlatformForms = FALSE;
+  *FeatureForms  = FALSE;
+  for (GuidHob = GetFirstGuidHob (&gEfiCfrSetupMenuFormGuid); GuidHob != NULL;
+       GuidHob = GetNextGuidHob (&gEfiCfrSetupMenuFormGuid, GET_NEXT_HOB (GuidHob)))
+  {
+    Form = GET_GUID_HOB_DATA (GuidHob);
+    if (Form->flags & CFR_OPTFLAG_PLATFORM) {
+      *PlatformForms = TRUE;
+    } else {
+      *FeatureForms = TRUE;
+    }
+  }
+}
+
+/**
+  Create runtime components by iterating CFR forms. Forms flagged CFR_OPTFLAG_PLATFORM go to the
+  Platform Setup Menu, the others to System Features.
 
 **/
 VOID
@@ -1043,6 +1075,8 @@ CfrCreateRuntimeComponents (
   VOID
   )
 {
+  VOID                *StartOpCodeHandles[2];
+  UINTN               Index;
   VOID                *StartOpCodeHandle;
   VOID                *EndOpCodeHandle;
   EFI_IFR_GUID_LABEL  *StartLabel;
@@ -1057,22 +1091,25 @@ CfrCreateRuntimeComponents (
   //
   // Allocate GUIDed markers at runtime component offset in IFR
   //
-  StartOpCodeHandle = HiiAllocateOpCodeHandle ();
-  ASSERT (StartOpCodeHandle != NULL);
 
   EndOpCodeHandle = HiiAllocateOpCodeHandle ();
   ASSERT (EndOpCodeHandle != NULL);
 
-  StartLabel = (EFI_IFR_GUID_LABEL *)HiiCreateGuidOpCode (
-                                       StartOpCodeHandle,
-                                       &gEfiIfrTianoGuid,
-                                       NULL,
-                                       sizeof (EFI_IFR_GUID_LABEL)
-                                       );
-  ASSERT (StartLabel != NULL);
+  for (Index = 0; Index < ARRAY_SIZE (StartOpCodeHandles); Index++) {
+    StartOpCodeHandles[Index] = HiiAllocateOpCodeHandle ();
+    ASSERT (StartOpCodeHandles[Index] != NULL);
 
-  StartLabel->ExtendOpCode = EFI_IFR_EXTEND_OP_LABEL;
-  StartLabel->Number       = LABEL_RT_COMP_START;
+    StartLabel = (EFI_IFR_GUID_LABEL *)HiiCreateGuidOpCode (
+                                         StartOpCodeHandles[Index],
+                                         &gEfiIfrTianoGuid,
+                                         NULL,
+                                         sizeof (EFI_IFR_GUID_LABEL)
+                                         );
+    ASSERT (StartLabel != NULL);
+
+    StartLabel->ExtendOpCode = EFI_IFR_EXTEND_OP_LABEL;
+    StartLabel->Number       = LABEL_RT_COMP_START;
+  }
 
   EndLabel = (EFI_IFR_GUID_LABEL *)HiiCreateGuidOpCode (
                                        EndOpCodeHandle,
@@ -1092,6 +1129,14 @@ CfrCreateRuntimeComponents (
   while (GuidHob != NULL) {
     CfrFormHob = GET_GUID_HOB_DATA (GuidHob);
 
+    //
+    // [0]: Platform Setup Menu, [1]: System Features
+    //
+    Index                       = (CfrFormHob->flags & CFR_OPTFLAG_PLATFORM) ? 0 : 1;
+    StartOpCodeHandle           = StartOpCodeHandles[Index];
+    mSetupMenuPrivate.HiiHandle = Index == 0 ? mSetupMenuPrivate.PlatformHiiHandle :
+                                  mSetupMenuPrivate.FeaturesHiiHandle;
+
     ProcessedLength = 0;
     CfrProcessFormOption (
       CfrFormHob,
@@ -1156,18 +1201,29 @@ CfrCreateRuntimeComponents (
     GuidHob = GetNextGuidHob (&gEfiCfrSetupMenuFormGuid, GET_NEXT_HOB (GuidHob));
   }
 
-  //
-  // Submit updates
-  //
-  Status = HiiUpdateForm (
-             mSetupMenuPrivate.HiiHandle,
-             &mSetupMenuFormsetGuid,
-             SETUP_MENU_FORM_ID,
-             StartOpCodeHandle,
-             EndOpCodeHandle
-             );
-  ASSERT_EFI_ERROR (Status);
+  if (mSetupMenuPrivate.PlatformHiiHandle != NULL) {
+    Status = HiiUpdateForm (
+               mSetupMenuPrivate.PlatformHiiHandle,
+               &mSetupMenuFormsetGuid,
+               SETUP_MENU_FORM_ID,
+               StartOpCodeHandles[0],
+               EndOpCodeHandle
+               );
+    ASSERT_EFI_ERROR (Status);
+  }
+
+  if (mSetupMenuPrivate.FeaturesHiiHandle != NULL) {
+    Status = HiiUpdateForm (
+               mSetupMenuPrivate.FeaturesHiiHandle,
+               &mSystemFeaturesFormsetGuid,
+               SETUP_MENU_FORM_ID,
+               StartOpCodeHandles[1],
+               EndOpCodeHandle
+               );
+    ASSERT_EFI_ERROR (Status);
+  }
 
-  HiiFreeOpCodeHandle (StartOpCodeHandle);
+  HiiFreeOpCodeHandle (StartOpCodeHandles[0]);
+  HiiFreeOpCodeHandle (StartOpCodeHandles[1]);
   HiiFreeOpCodeHandle (EndOpCodeHandle);
 }
