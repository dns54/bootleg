@@ -28,6 +28,8 @@ CfrSetupMenuEntryPoint (
   )
 {
   EFI_STATUS  Status;
+  BOOLEAN     PlatformForms;
+  BOOLEAN     FeatureForms;
 
   //
   // If the bootloader did not provide any CFR forms, do not register the menu.
@@ -56,16 +58,31 @@ CfrSetupMenuEntryPoint (
   ASSERT_EFI_ERROR (Status);
 
   //
-  // Publish our HII data.
+  // Publish our HII data: a package list per formset, as Device Manager only looks at a package
+  // list's first formset. Only the formsets that get forms, so neither shows up empty.
   //
-  mSetupMenuPrivate.HiiHandle = HiiAddPackages (
-                                  &mSetupMenuFormsetGuid,
