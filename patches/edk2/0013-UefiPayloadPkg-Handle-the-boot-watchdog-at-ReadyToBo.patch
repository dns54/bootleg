new file mode 100644
index 0000000000..0a64211ad5
--- /dev/null
+++ b/UefiPayloadPkg/TcoWatchdogDxe/TcoWatchdogDxe.c
@@ -0,0 +1,182 @@
+/** @file
+  Handle the boot watchdog that coreboot arms in the Intel PCH TCO timer.
+
+  The "Watchdog Timer Support" setup option picks what happens at a boot attempt: "Boot Only"
+  halts the timer, "Boot and OS" reloads it and leaves it to the OS. Setup and the boot manager
+  halt it either way, and a capsule update boot halts it right away.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <PiDxe.h>
+#include <IndustryStandard/Pci.h>
+#include <Protocol/LoadedImage.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/CfrHelpersLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/HobLib.h>
+#include <Library/IoLib.h>
+#include <Library/PciLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+
+#define SMBUS_PCI          PCI_LIB_ADDRESS (0, 0x1f, 4, 0)
+#define SMBUS_TCOBASE      0x50
+#define SMBUS_TCOCTL       0x54
+#define  TCO_BASE_EN       BIT8
+#define TCO_RLD            0x00
+#define TCO1_STS           0x04
+#define  TCO1_STS_TIMEOUT  BIT3
+#define TCO1_CNT           0x08
+#define  TCO1_TMR_HLT      BIT11
+
+// coreboot's watchdog option value
+#define WATCHDOG_BOOT_AND_OS  2
+
+// UiApp's FILE_GUID: the setup front page
+STATIC CONST EFI_GUID  mUiAppFile = {
+  0x462CAA21, 0x7614, 0x4503, { 0x83, 0x6E, 0x8A, 0xB6, 0xF4, 0x66, 0x23, 0x31 }
+};
+
+STATIC UINT16  mTcoBase;
+STATIC VOID    *mImageRegistration;
+
+/**
+  Halt the TCO timer.
+**/
+STATIC
+VOID
+HaltWatchdog (
+  VOID
+  )
+{
+  IoOr16 (mTcoBase + TCO1_CNT, TCO1_TMR_HLT);
+  DEBUG ((DEBUG_INFO, "TcoWatchdog: halted\n"));
+}
+
+/**
+  At a boot attempt, halt the timer, or with "Boot and OS" restart its countdown for the OS.
+
+  @param[in]  Event    The ReadyToBoot event.
+  @param[in]  Context  Unused.
+**/
+STATIC
+VOID
+EFIAPI
+OnReadyToBoot (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  if (CfrOptionGetUint32 ("watchdog", 0) != WATCHDOG_BOOT_AND_OS) {
+    HaltWatchdog ();
+    return;
+  }
+
+  //
+  // Clear a pending timeout and reload. Once SMM is up, coreboot's SMI handler resets on the
+  // first timeout, so the OS gets one full TCO period.
+  //
+  IoWrite16 (mTcoBase + TCO1_STS, TCO1_STS_TIMEOUT);
+  IoWrite16 (mTcoBase + TCO_RLD, 1);
+  IoAnd16 (mTcoBase + TCO1_CNT, (UINT16) ~TCO1_TMR_HLT);
+  DEBUG ((DEBUG_INFO, "TcoWatchdog: running for the OS\n"));
+}
+
+/**
+  Halt the timer when the setup or boot manager app is loaded. Launching the boot manager
+  doesn't signal ReadyToBoot.
+
+  @param[in]  Event    The LoadedImage protocol notification.
+  @param[in]  Context  Unused.
+**/
+STATIC
+VOID
+EFIAPI
+OnImageLoaded (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_HANDLE                 Handle;
+  UINTN                      Size;
+  EFI_LOADED_IMAGE_PROTOCOL  *Image;
+  EFI_GUID                   *File;
+
+  while (TRUE) {
+    Size = sizeof (Handle);
+    if (EFI_ERROR (
+          gBS->LocateHandle (
+                 ByRegisterNotify,
+                 NULL,
+                 mImageRegistration,
+                 &Size,
+                 &Handle
+                 )
+          ))
+    {
+      return;
+    }
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handle, &gEfiLoadedImageProtocolGuid, (VOID **)&Image)) ||
+        (Image->FilePath == NULL))
+    {
+      continue;
+    }
+
+    File = EfiGetNameGuidFromFwVolDevicePathNode (
+             (MEDIA_FW_VOL_FILEPATH_DEVICE_PATH *)Image->FilePath
+             );
+    if ((File != NULL) &&
+        (CompareGuid (File, &mUiAppFile) || CompareGuid (File, PcdGetPtr (PcdBootManagerMenuFile))))
+    {
+      HaltWatchdog ();
+    }
+  }
+}
+
+/**
+  Entry point.
+
+  @param[in]  ImageHandle  The image handle.
+  @param[in]  SystemTable  The system table.
+
+  @retval EFI_SUCCESS      The watchdog is handled.
+  @retval EFI_UNSUPPORTED  There is no running PCH TCO timer.
+**/
+EFI_STATUS
+EFIAPI
+TcoWatchdogDxeEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_EVENT  Event;
+
+  if ((PciRead16 (SMBUS_PCI + PCI_VENDOR_ID_OFFSET) != 0x8086) ||
+      ((PciRead32 (SMBUS_PCI + SMBUS_TCOCTL) & TCO_BASE_EN) == 0))
+  {
+    return EFI_UNSUPPORTED;
+  }
+
+  mTcoBase = (UINT16)(PciRead32 (SMBUS_PCI + SMBUS_TCOBASE) & 0xFFE0);
+  if ((mTcoBase == 0) || ((IoRead16 (mTcoBase + TCO1_CNT) & TCO1_TMR_HLT) != 0)) {
+    return EFI_UNSUPPORTED;
+  }
+
+  if (GetBootModeHob () == BOOT_ON_FLASH_UPDATE) {
+    HaltWatchdog ();
+    return EFI_SUCCESS;
+  }
+
+  EfiCreateProtocolNotifyEvent (
+    &gEfiLoadedImageProtocolGuid,
+    TPL_CALLBACK,
+    OnImageLoaded,
+    NULL,
+    &mImageRegistration
+    );
+  return EfiCreateEventReadyToBootEx (TPL_CALLBACK, OnReadyToBoot, NULL, &Event);
+}
