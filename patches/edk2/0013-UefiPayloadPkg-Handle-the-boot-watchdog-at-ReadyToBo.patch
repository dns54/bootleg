+  BASE_NAME                      = TcoWatchdogDxe
+  FILE_GUID                      = 6C2C1F2E-7A1B-4F8E-9F43-3B7D6A0E5C21
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = TcoWatchdogDxeEntry
+
+[Sources]
