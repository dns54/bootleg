+++ b/MdeModulePkg/Library/DxeCapsuleLibFmp/CapsuleOnDisk.c
@@ -1147,7 +1147,8 @@ EXIT:
 
 **/
 EFI_STATUS
-GetAllCapsuleOnDisk (
