From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
Date: Tue, 6 Jan 2026 01:08:23 +0200
Subject: [PATCH 08/25] MdeModulePkg: support "immediate" on-disk capsules

That is loading and processing on-disk capsules during the same boot
without relocating the capsules to a dedicated non-volatile storage on
ESP or loading them as in-RAM capsules and then rebooting.

Signed-off-by: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
Link: https://github.com/Dasharo/edk2/commit/b828f7bf3edd733ff3b696b6cbc48bdc94ba4f61
[Deividas Nastajus: CapsuleLib.h hunks applied by hand (#pragma once); added the CoDGetAll rename from Dasharo's 2b93ded2ef24; dropped CoDPresent(), which nothing calls]
Signed-off-by: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
---
 MdeModulePkg/Include/Library/CapsuleLib.h     | 52 ++++++++++++++
 .../Library/DxeCapsuleLibFmp/CapsuleOnDisk.c  | 32 +++++----
 .../Library/DxeCapsuleLibFmp/CapsuleOnDisk.h  | 12 ----
 .../DxeCapsuleLibFmp/DxeCapsuleProcessLib.c   | 69 ++++++++++++++++++-
 .../CapsuleRuntimeDxe/CapsuleRuntimeDxe.inf   |  1 +
 .../CapsuleRuntimeDxe/CapsuleService.c        |  9 ++-
 6 files changed, 147 insertions(+), 28 deletions(-)

diff --git a/MdeModulePkg/Include/Library/CapsuleLib.h b/MdeModulePkg/Include/Library/CapsuleLib.h
index 1ff2227c50..8313746242 100644
--- a/MdeModulePkg/Include/Library/CapsuleLib.h
+++ b/MdeModulePkg/Include/Library/CapsuleLib.h
@@ -9,6 +9,20 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 
 #pragma once
 
+#include <Guid/FileInfo.h>
+
+typedef struct {
+  //
+  // image address.
+  //
+  VOID             *ImageAddress;
+  //
+  // The file info of the image comes from.
+  //  if FileInfo == NULL. means image does not come from file
+  //
+  EFI_FILE_INFO    *FileInfo;
+} IMAGE_INFO;
+
 //
 // BOOLEAN Variable to indicate whether system is in the capsule on disk state.
 //
@@ -155,3 +169,41 @@ EFIAPI
 CoDRemoveTempFile (
   UINTN  MaxRetry
   );
+
+/**
+  This routine is called to get all capsules from file. The capsule file image is
+  copied to BS memory. Caller is responsible to free them.
+
+  @param[in]    MaxRetry             Max Connection Retry. Stall 100ms between each connection try to ensure
+                                     devices like USB can get enumerated.
+  @param[out]   CapsulePtr           Copied Capsule file Image Info buffer
+  @param[out]   CapsuleNum           CapsuleNumber
+  @param[out]   FsHandle             File system handle
+  @param[out]   LoadOptionNumber     OptionNumber of boot option
+
+  @retval EFI_SUCCESS  Succeed to get all capsules.
+
+**/
+EFI_STATUS
+EFIAPI
+CoDGetAll (
+  IN  UINTN       MaxRetry,
+  OUT IMAGE_INFO  **CapsulePtr,
+  OUT UINTN       *CapsuleNum,
+  OUT EFI_HANDLE  *FsHandle,
+  OUT UINT16      *LoadOptionNumber
+  );
+
+/**
+  Free resources allocated by CoDGetAll.
+
+  @param[in]  ImageInfo  An array of data and information of files
+  @param[in]  Count      Length of the array.
+
+**/
+VOID
+EFIAPI
+CoDFreeImages (
+  IN IMAGE_INFO  *ImageInfo,
+  IN UINTN       Count
+  );
diff --git a/MdeModulePkg/Library/DxeCapsuleLibFmp/CapsuleOnDisk.c b/MdeModulePkg/Library/DxeCapsuleLibFmp/CapsuleOnDisk.c
