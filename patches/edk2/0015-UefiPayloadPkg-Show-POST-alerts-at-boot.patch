@@ -153,3 +153,22 @@ PlatformBootManagerShowProgress (
   IN UINTN                          Progress,
   IN UINTN                          PreviousValue
   );
+
+/**
+  Start watching for SATA SMART failures. Call before the disks are connected.
+**/
+VOID
+BootAlertsStart (
+  VOID
+  );
+
+/**
+  Show the alerts found before boot. Call after the disks are connected.
+
+  @retval TRUE   At least one alert was shown.
+  @retval FALSE  No alerts.
+**/
+BOOLEAN
+BootAlertsShow (
+  VOID
+  );
