From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:44:09 +0200
Subject: [PATCH 20/29] commonlib/cfr.h: Add CFR_OPTFLAG_PLATFORM for forms

A setup menu mixes options for the firmware itself (security, boot
sources, console) with options for the machine's hardware (CPU,
chipset, PCIe, power, ports). Let a form say it belongs to the second
group, so the UI can keep the two apart. EDK2's CfrSetupMenuDxe shows
such forms in the Platform Setup Menu and the other forms in System
Features.

Signed-off-by: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
---
 src/commonlib/include/commonlib/cfr.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/commonlib/include/commonlib/cfr.h b/src/commonlib/include/commonlib/cfr.h
index be26fd32da..29a6f9f351 100644
--- a/src/commonlib/include/commonlib/cfr.h
+++ b/src/commonlib/include/commonlib/cfr.h
@@ -104,6 +104,9 @@ enum cfr_tags {
  *   Ignored if CFR_OPTFLAG_READONLY is set (display-only locks
  *   immediately). Without CFR_OPTFLAG_RUNTIME the OS cannot see or write
  *   the variable after handoff regardless of this flag.
+ * CFR_OPTFLAG_PLATFORM:
+ *   Forms only. The form holds platform-specific options, which the UI
+ *   keeps apart from the firmware's own features.
  */
 enum cfr_option_flags {
 	CFR_OPTFLAG_READONLY	= 1 << 0,
@@ -112,6 +115,7 @@ enum cfr_option_flags {
 	CFR_OPTFLAG_VOLATILE	= 1 << 3,
 	CFR_OPTFLAG_RUNTIME	= 1 << 4,
 	CFR_OPTFLAG_LOCK_AT_BOOT = 1 << 5,
+	CFR_OPTFLAG_PLATFORM	= 1 << 6,
 };
 
 struct __packed lb_cfr_varbinary {
