From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
Date: Tue, 17 Nov 2026 12:00:00 +0200
Subject: [PATCH 29/29] util/genbuild_h: Use SOURCE_DATE_EPOCH outside git

Outside a git checkout, the build date is the time of the build, so no
two builds are the same. Reproducible-build systems such as Nix and
Debian pass a fixed date in SOURCE_DATE_EPOCH: use it when it is set.

Signed-off-by: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
---
 Makefile.mk                   | 2 +-
 util/genbuild_h/genbuild_h.sh | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Makefile.mk b/Makefile.mk
index 0615727d17..92b297cf83 100644
--- a/Makefile.mk
+++ b/Makefile.mk
@@ -666,7 +666,7 @@ build_h := $(obj)/build.h
 # when we call it through the `$(shell)` function. This is fragile
 # but as variables newly added to `genbuild_h.sh` would just not
 # work, we'd notice that instantly at least.
-build_h_exports := BUILD_TIMELESS KERNELVERSION COREBOOT_EXTRA_VERSION
+build_h_exports := BUILD_TIMELESS KERNELVERSION COREBOOT_EXTRA_VERSION SOURCE_DATE_EPOCH
 
 # Report new `build.ht` as dependency if `build.h` differs.
 build_h_check := \
diff --git a/util/genbuild_h/genbuild_h.sh b/util/genbuild_h/genbuild_h.sh
index e83d4e177f..003b9d3f74 100755
--- a/util/genbuild_h/genbuild_h.sh
+++ b/util/genbuild_h/genbuild_h.sh
@@ -42,7 +42,7 @@ elif [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]; then
 else
 	GITREV=Unknown
 	TIMESOURCE="date"
-	DATE=$(LANG="" LC_ALL=C TZ=UTC0 date +%s)
+	DATE="${SOURCE_DATE_EPOCH:-$(LANG="" LC_ALL=C TZ=UTC0 date +%s)}"
 	if [ -f "${COREBOOT_VERSION_FILE}" ]; then
 		MAJOR_VER="$(sed -n 's/^0*\([0-9]*\)\.0*\([0-9]*\).*/\1/p' "${COREBOOT_VERSION_FILE}")"
 		MINOR_VER="$(sed -n 's/^0*\([0-9]*\)\.0*\([0-9]*\).*/\2/p' "${COREBOOT_VERSION_FILE}")"
