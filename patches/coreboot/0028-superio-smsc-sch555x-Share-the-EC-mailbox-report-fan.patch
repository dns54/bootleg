diff --git a/src/superio/smsc/sch555x/acpi/fan.asl b/src/superio/smsc/sch555x/acpi/fan.asl
new file mode 100644
index 0000000000..6799c5bc3b
--- /dev/null
+++ b/src/superio/smsc/sch555x/acpi/fan.asl
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+/* ACPI fan devices for the fans the SCH555x watches. The EC controls them; the OS reads the speed. */
+
+Scope (\_SB)
+{
+	OperationRegion (SEMB, SystemIO, 0x0a00, 2)	/* SCH555x_EMI_IOBASE */
+	Field (SEMB, ByteAcc, NoLock, Preserve)
+	{
+		SH2E, 8,	/* Host-to-EC mailbox */
+		SE2H, 8,	/* EC-to-host mailbox */
+	}
+
+	OperationRegion (SEMA, SystemIO, 0x0a02, 2)
+	Field (SEMA, WordAcc, NoLock, Preserve)
+	{
+		SADR, 16,	/* EC address and access size */
+	}
+
+	OperationRegion (SEMD, SystemIO, 0x0a04, 4)
+	Field (SEMD, DWordAcc, NoLock, Preserve)
+	{
+		SDAT, 32,
+	}
+	Field (SEMD, WordAcc, NoLock, Preserve)
+	{
+		SDTW, 16,
+	}
+	Field (SEMD, ByteAcc, NoLock, Preserve)
+	{
+		SDTB, 8,
+	}
+
+	/* Read hardware monitor register Arg0 (mailbox bank 1), like sch555x_mbox_read() */
+	Method (SHWR, 1, Serialized)
+	{
+		Local0 = SE2H		/* clear the EC-to-host mailbox */
+		SE2H = Local0
+		SADR = 0x8001
+		SDTW = 0x0102
+		SADR = 0x8006
+		SDAT = Arg0 << 16
+		SH2E = 1
+		Local0 = 0
+		While (!(SE2H & 1) && (Local0 < 1000)) {
+			Stall (5)
+			Local0++
+		}
+		SADR = 0x8004
+		Return (SDTB)
+	}
+
+	/* 16-bit register Arg0: reading the LSB latches the MSB */
+	Method (SHW2, 1, Serialized)
+	{
+		Local0 = SHWR (Arg0)
+		Return (Local0 | (SHWR (Arg0 + 1) << 8))
+	}
+
+/*
+ * All four ACPI 4.0 fan objects: Linux before 6.15 shows the speed only with all of them.
+ * One fixed performance state, since the EC controls the fan. 0xffffffff: not available.
+ */
+#define SCH555x_FAN(N)								\
+	Device (FAN##N)								\
+	{									\
+		Name (_HID, EisaId ("PNP0C0B"))					\
+		Name (_UID, N)							\
+		/* Present when the firmware programmed its minimum speed. */	\
+		/* 0xffff is the reset value, 0 a fan the EC doesn't have. */	\
+		Method (_STA)							\
+		{								\
+			Local0 = SHW2 (0x62 + 2 * N)				\
+			If ((Local0 == 0xffff) || (Local0 == 0)) {		\
+				Return (0)					\
+			}							\
+			Return (0x0f)						\
+		}								\
+		Name (_FIF, Package () { 0, 0, 1, 0 })				\
+		Name (_FPS, Package () {					\
+			0,							\
+			Package () { 0, 0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff } \
+		})								\
+		Method (_FSL, 1)						\
+		{								\
+		}								\
+		Method (_FST)							\
+		{								\
+			Local0 = Package () { 0, 0, 0xffffffff }		\
+			Local1 = SHW2 (0x2c + 2 * N)				\
+			If (Local1 == 0xffff) {					\
+				Local0[2] = 0					\
+			} ElseIf (Local1 != 0) {				\
+				Local0[2] = 5400540 / Local1			\
+			}							\
+			Return (Local0)						\
+		}								\
+	}
+
+	SCH555x_FAN(0)
+	SCH555x_FAN(1)
+	SCH555x_FAN(2)
+	SCH555x_FAN(3)
+}
diff --git a/src/superio/smsc/sch555x/ec.c b/src/superio/smsc/sch555x/ec.c
new file mode 100644
index 0000000000..fc5b48a517
--- /dev/null
+++ b/src/superio/smsc/sch555x/ec.c
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <arch/io.h>
+#include <console/console.h>
+#include <delay.h>
+#include <device/pnp_ops.h>
+#include <types.h>
+#include "sch555x.h"
+
+uint8_t sch555x_mbox_read(uint8_t addr1, uint16_t addr2)
+{
+	// clear ec-to-host mailbox
+	uint8_t tmp = inb(SCH555x_EMI_IOBASE + 1);
+	outb(tmp, SCH555x_EMI_IOBASE + 1);
+
+	// send address
+	outw(0 | 0x8001, SCH555x_EMI_IOBASE + 2);
+	outw((addr1 * 2) | 0x100, SCH555x_EMI_IOBASE + 4);
+
+	outw(4 | 0x8002, SCH555x_EMI_IOBASE + 2);
+	outl(addr2 << 16, SCH555x_EMI_IOBASE + 4);
+
+	// send message to ec
+	outb(1, SCH555x_EMI_IOBASE);
+
+	// wait for ack
+	for (size_t retry = 0; retry < 0xfff; ++retry)
+		if (inb(SCH555x_EMI_IOBASE + 1) & 1)
+			break;
+
+	// read result
+	outw(4 | 0x8000, SCH555x_EMI_IOBASE + 2);
+	return inb(SCH555x_EMI_IOBASE + 4);
+}
+
+void sch555x_mbox_write(uint8_t addr1, uint16_t addr2, uint8_t val)
+{
+	// clear ec-to-host mailbox
+	uint8_t tmp = inb(SCH555x_EMI_IOBASE + 1);
+	outb(tmp, SCH555x_EMI_IOBASE + 1);
+
+	// send address and value
+	outw(0 | 0x8001, SCH555x_EMI_IOBASE + 2);
+	outw((addr1 * 2) | 0x101, SCH555x_EMI_IOBASE + 4);
+
+	outw(4 | 0x8002, SCH555x_EMI_IOBASE + 2);
+	outl(val | (addr2 << 16), SCH555x_EMI_IOBASE + 4);
+
+	// send message to ec
+	outb(1, SCH555x_EMI_IOBASE);
+
+	// wait for ack
+	for (size_t retry = 0; retry < 0xfff; ++retry)
+		if (inb(SCH555x_EMI_IOBASE + 1) & 1)
+			break;
+}
+
+static uint16_t hwm_read16(uint16_t reg)
+{
+	/* Reading the LSB latches the MSB */
+	const uint8_t lsb = sch555x_mbox_read(1, reg);
+	return lsb | sch555x_mbox_read(1, reg + 1) << 8;
+}
+
+bool sch555x_fan_failure(void)
+{
+	bool failure = false;
+
+	for (unsigned int i = 0; i < SCH555x_HWM_FANS; i++) {
+		/* Unmonitored: 0xffff is the reset value, 0 a fan the SCH5555 doesn't have */
+		const uint16_t min = hwm_read16(SCH555x_HWM_FAN_MIN(i));
+		if (min == 0xffff || min == 0)
+			continue;
+
+		/* The count is the time per revolution: higher is slower. Allow a second to spin up. */
+		uint16_t count = hwm_read16(SCH555x_HWM_FAN(i));
+		for (unsigned int ms = 0; count > min && ms < 1000; ms += 100) {
+			mdelay(100);
+			count = hwm_read16(SCH555x_HWM_FAN(i));
+		}
+
+		if (count > min) {
+			printk(BIOS_WARNING, "SCH555x: fan %u is stopped or below its minimum speed\n",
+			       i + 1);
+			failure = true;
+		} else if (count) {
+			printk(BIOS_INFO, "SCH555x: fan %u at %u RPM\n", i + 1,
+			       SCH555x_HWM_FAN_RPM / count);
+		}
+	}
+
+	return failure;
+}
diff --git a/src/superio/smsc/sch555x/sch555x.h b/src/superio/smsc/sch555x/sch555x.h
index 4af95eca1c..5298dac9f6 100644
--- a/src/superio/smsc/sch555x/sch555x.h
+++ b/src/superio/smsc/sch555x/sch555x.h
@@ -58,6 +58,20 @@ void sch555x_emi_write8(uint16_t addr, uint8_t val);
 void sch555x_emi_write16(uint16_t addr, uint16_t val);
 void sch555x_emi_write32(uint16_t addr, uint32_t val);
 
+uint8_t sch555x_mbox_read(uint8_t addr1, uint16_t addr2);
+void sch555x_mbox_write(uint8_t addr1, uint16_t addr2, uint8_t val);
+
+/*
+ * Hardware monitor fans (mailbox bank 1), 16-bit, LSB first. The count is the time per
+ * revolution, 0xffff when the fan is stopped.
+ */
+#define SCH555x_HWM_FANS		4
+#define SCH555x_HWM_FAN(i)		(0x2c + 2 * (i))
+#define SCH555x_HWM_FAN_MIN(i)		(0x62 + 2 * (i))
+#define SCH555x_HWM_FAN_RPM		5400540	/* divided by the count */
+
+bool sch555x_fan_failure(void);
+
 /*
  * Bootblock entry points
  */
