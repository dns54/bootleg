From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:30:00 +0200
Subject: [PATCH 27/29] soc/intel/skylake: Add the Coffee Lake desktop CPUs to
 the VR tables

Coffee Lake desktop CPUs also run on 100/200-series boards. The VR
tables here only know Skylake and Kaby Lake system agents, so for
these CPUs coreboot logs "Unknown MCH (0x3e1f) in get_sku_icc_max"
and passes FSP an Icc max and AC/DC loadlines of 0 for every domain,
leaving the voltage regulators unconfigured.

Add the Coffee Lake desktop system agents (2, 4, 6 and 8 cores; desktop,
server and workstation) with the values soc/intel/cannonlake uses for
the same CPUs, from Intel's CFL-S datasheet #337344.

Signed-off-by: Deividas Nastajus <16858119+dns54@users.noreply.github.com>
---
 src/soc/intel/skylake/vr_config.c | 81 +++++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)

diff --git a/src/soc/intel/skylake/vr_config.c b/src/soc/intel/skylake/vr_config.c
index a036a1b016..eb83287392 100644
--- a/src/soc/intel/skylake/vr_config.c
+++ b/src/soc/intel/skylake/vr_config.c
@@ -118,6 +118,21 @@ static uint16_t get_sku_icc_max(int domain)
 	 *   SKL/KBL-Y            (4.5W)            4.1      24      24
 	 *
 	 *   [*] Pentium/Celeron CPUs with HD Graphics 610
+	 *
+	 * Coffee Lake CPUs on 200-series boards, from CFL-S #337344 as in
+	 * soc/intel/cannonlake:
+	 *
+	 *   CFL-S                (95W) octa        11.1     193     45
+	 *   CFL-S                (65W) octa        11.1     186     45
+	 *   CFL-S                (95W) hex         11.1     138     45
+	 *   CFL-S                (65W) hex         11.1     133     45
+	 *   CFL-S                (35W) hex/octa    11.1     104     35
+	 *   CFL-S                (71W) quad        11.1     100     45
+	 *   CFL-S                (62W) quad        11.1     79      45
+	 *   CFL-S                (35W) quad        11.1     66      35
+	 *   CFL-S                (58W) dual        11.1     79      35
+	 *   CFL-S                (54W) dual        11.1     58      45
+	 *   CFL-S                (35W) dual        11.1     40      35
 	 */
 
 	switch (mch_id) {
@@ -221,6 +236,54 @@ static uint16_t get_sku_icc_max(int domain)
 
 		return icc_max[domain];
 	}
+	case PCI_DID_INTEL_CFL_ID_S_DT_8: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_8:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_8: {
+		uint16_t icc_max[NUM_VR_DOMAINS] = VR_CFG_ALL_DOMAINS_ICC(11.1, 104, 45, 45);
+		if (tdp >= 80)
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(193);
+		else if (tdp >= 65)
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(186);
+		else
+			icc_max[VR_GT_SLICED] = icc_max[VR_GT_UNSLICED] = VR_CFG_AMP(35);
+
+		return icc_max[domain];
+	}
+	case PCI_DID_INTEL_CFL_ID_S:      /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_6:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_6: {
+		uint16_t icc_max[NUM_VR_DOMAINS] = VR_CFG_ALL_DOMAINS_ICC(11.1, 104, 45, 45);
+		if (tdp >= 95)
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(138);
+		else if (tdp >= 65)
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(133);
+		else
+			icc_max[VR_GT_SLICED] = icc_max[VR_GT_UNSLICED] = VR_CFG_AMP(35);
+
+		return icc_max[domain];
+	}
+	case PCI_DID_INTEL_CFL_ID_S_DT_4: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_4:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_4: {
+		uint16_t icc_max[NUM_VR_DOMAINS] = VR_CFG_ALL_DOMAINS_ICC(11.1, 66, 35, 35);
+		if (tdp >= 62) {
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(tdp >= 71 ? 100 : 79);
+			icc_max[VR_GT_SLICED] = icc_max[VR_GT_UNSLICED] = VR_CFG_AMP(45);
+		}
+
+		return icc_max[domain];
+	}
+	case PCI_DID_INTEL_CFL_ID_S_DT_2: {
+		uint16_t icc_max[NUM_VR_DOMAINS] = VR_CFG_ALL_DOMAINS_ICC(11.1, 40, 35, 35);
+		if (tdp >= 58) {
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(79);
+		} else if (tdp >= 54) {
+			icc_max[VR_IA_CORE] = VR_CFG_AMP(58);
+			icc_max[VR_GT_SLICED] = icc_max[VR_GT_UNSLICED] = VR_CFG_AMP(45);
+		}
+
+		return icc_max[domain];
+	}
 	default:
 		printk(BIOS_ERR, "Unknown MCH (0x%x) in %s\n", mch_id, __func__);
 	}
@@ -291,6 +354,24 @@ static uint16_t get_sku_ac_dc_loadline(const int domain)
 
 		return loadline[domain];
 	}
+	case PCI_DID_INTEL_CFL_ID_S_DT_8: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_8:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_8: {
+		const uint16_t loadline[NUM_VR_DOMAINS] =
+				VR_CFG_ALL_DOMAINS_LOADLINE(10.3, 1.6, 3.1, 3.1);
+		return loadline[domain];
+	}
+	case PCI_DID_INTEL_CFL_ID_S:      /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_6:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_6: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_DT_4: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_S_4:  /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_WS_4: /* fallthrough */
+	case PCI_DID_INTEL_CFL_ID_S_DT_2: {
+		const uint16_t loadline[NUM_VR_DOMAINS] =
+				VR_CFG_ALL_DOMAINS_LOADLINE(10.3, 2.1, 3.1, 3.1);
+		return loadline[domain];
+	}
 	default:
 		printk(BIOS_ERR, "Unknown MCH (0x%x) in %s\n", mch_id, __func__);
 	}
